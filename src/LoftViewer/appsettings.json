{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secrets are never stored here. Locally use `dotnet user-secrets`; in Railway set environment
  // variables such as MongoDBSettings__Password, JwtSettings__Secret and WeatherSettings__ApiKey.
  "MongoDBSettings": {
    "Host": "birdscluster.i94fe.mongodb.net",
    "AppName": "BirdsCluster",
    "DatabaseName": "BirdsDB"
  },
  "JwtSettings": {
    "Issuer": "LoftViewer",
    "Audience": "LoftViewerUsers",
    "ExpirationMinutes": 60
  },
  "WeatherSettings": {
    "DefaultCity": "Tampa",
    "RefreshMinutes": 10,
    "MaxCallsPerDay": 900
  },
  "Cors": {
    "AllowedOrigins": [ "https://www.reyfamilyloft.com" ]
  },
  "Swagger": {
    "Enabled": false
  }
}
